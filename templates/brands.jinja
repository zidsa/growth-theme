{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ _('All Brands') }}{% endblock %}

{% block content %}

  {# Breadcrumb Section #}
  <section class="px-4 py-6 md:px-16">
    <div class="theme-container">
      {%
        with
        items=[
          {'href': url_for('home'), 'label': _("Home")},
          {'label': _("All Brands")}
        ]
      %}
        {% include 'components/ui/breadcrumb.jinja' %}
      {% endwith %}
    </div>
  </section>

  {# Main Categories Grid #}
  <section class="px-4 pb-16 md:px-16">
    <div class="theme-container">
      <div class="flex flex-col gap-6">
        {# Section Title #}
        <h2 class="text-foreground text-xl md:text-2xl font-semibold tracking-tight">{{ _("Brands") }}</h2>

        {# Categories Grid - 3 columns #}
        {% if brands and brands.results|length > 0 %}
          <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
            {% for brand in brands.results %}
              {% with brand=brand, index=loop.index0 %}
                {% include 'components/brands/brand-card.jinja' %}
              {% endwith %}
            {% endfor %}
          </div>
        {% else %}
          <div class="bg-secondary flex flex-col items-center justify-center rounded-lg py-16">
            <p class="text-muted text-sm">{{ _("No brands found") }}</p>
          </div>
        {% endif %}
        {% set totalPages = ((brands.count / (session.query_params.get('page_size') or 24)|int) | round(0, 'ceil')) | int %}
        {% set currentPage = brands.page %}
        {% include 'components/products/pagination.jinja' %}
      </div>
    </div>
  </section>
{% endblock %}
