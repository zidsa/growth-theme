{% if store.settings.checkout.gift_order_settings.is_gift_order_enabled == '1' %}
  <a
    href="{{ url_for('cart_page') }}"
    class="btn btn-outlined btn-lg w-full justify-start"
    data-gift-order-link
  >
    <svg
      class="text-accent size-6 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <span class="text-foreground text-sm font-medium">{{ _("Want to send a gift order?") }}</span>
    <span class="text-muted text-sm">{{ _("Check the cart") }}</span>
  </a>
{% endif %}
